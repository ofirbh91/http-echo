[Unit]
Description=Local HTTP echo ingress forwarding
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ofirb
Environment=KUBECONFIG=/home/ofirb/.kube/config
ExecStart=/usr/local/bin/kubectl --context=minikube -n ingress-nginx port-forward service/ingress-nginx-controller --address=127.0.0.1 80:80 443:443
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
