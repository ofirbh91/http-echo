# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
.local/
artifacts/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
image/
/tests/
scripts/
ops/
docs/
coverage/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.agents/
.codex/
.aws/
